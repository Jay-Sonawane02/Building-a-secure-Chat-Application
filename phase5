#include <thread>
#include <chrono>
#include <atomic>

static std::atomic<bool> active_session(true);
extern std::string local_username;

bool should_initiate_rekey(const std::string& peer_name) {
    return local_username < peer_name;
}

void rekey_timer_thread(int sock, std::string peer_name) {
    while (active_session) {
        std::this_thread::sleep_for(std::chrono::seconds(60));
        
        if (!active_session) break;

        if (should_initiate_rekey(peer_name)) {
            std::cout << "[FS] Initiating scheduled 60-second key rotation with " << peer_name << "...\n";
            
            BIGNUM *priv = nullptr, *pub = nullptr;
            generate_dh_keypair(&priv, &pub);
            
            char *pub_hex = BN_bn2hex(pub);
            send_e2e_packet(sock, peer_name, "__E2E_REKEY_INIT__", std::string(pub_hex));
            
            OPENSSL_free(pub_hex);
            BN_free(priv);
            BN_free(pub);
        } else {
            std::cout << "[FS] Waiting for peer " << peer_name << " to drive key rotation...\n";
        }
    }
}

void handle_rekey_packet(int sock, const std::string& sender, const std::string& payload) {
    std::string peer_pub_hex = payload;
    BIGNUM *priv_key = nullptr;
    BIGNUM *pub_key = nullptr;
    generate_dh_keypair(&priv_key, &pub_key);

    BIGNUM *peer_pub = nullptr;
    BN_hex2bn(&peer_pub, peer_pub_hex.c_str());

    unsigned char raw_secret[256];
    int secret_len = compute_shared_secret(peer_pub, priv_key, raw_secret);
    
    unsigned char derived_key[32];
    sha256(raw_secret, secret_len, derived_key);

  
    memcpy(e2e_sessions[sender].shared_key, derived_key, 32);

    std::cout << "[FS] Key rotation completed successfully with " << sender << ".\n";

    BN_free(priv_key);
    BN_free(pub_key);
    BN_free(peer_pub);
}
