#include <iostream>
#include <string>
#include <cstring>
#include <map>
#include <openssl/evp.h>
#include <openssl/rand.h>
#include "../common/dh.h"
#include "../common/aes_gcm.h"
#include "../common/sha256.h"

struct E2ESession {
    unsigned char shared_key[32];
    bool established;
};

std::map<std::string, E2ESession> e2e_sessions;

void send_e2e_packet(int sock, const std::string& recipient, const std::string& tag, const std::string& payload) {
    std::string message = "@" + recipient + " " + tag + payload;
    send(sock, message.c_str(), message.length(), 0);
}

void initiate_e2e_handshake(int sock, const std::string& target_user) {
    BIGNUM *private_key = nullptr;
    BIGNUM *public_key = nullptr;
    generate_dh_keypair(&private_key, &public_key);

    char *pub_hex = BN_bn2hex(public_key);
    std::string pub_str(pub_hex);
    OPENSSL_free(pub_hex);

    send_e2e_packet(sock, target_user, "__E2E_INIT__", pub_str);
    std::cout << "[E2E] Initiated key exchange with " << target_user << "\n";

    BN_free(private_key);
    BN_free(public_key);
}

void handle_e2e_message(int sock, const std::string& sender, const std::string& raw_content) {
    if (raw_content.rfind("__E2E_INIT__", 0) == 0) {
        std::string peer_pub_hex = raw_content.substr(12);
        
        BIGNUM *priv_key = nullptr;
        BIGNUM *pub_key = nullptr;
        generate_dh_keypair(&priv_key, &pub_key);

        BIGNUM *peer_pub = nullptr;
        BN_hex2bn(&peer_pub, peer_pub_hex.c_str());

        unsigned char raw_secret[256];
        int secret_len = compute_shared_secret(peer_pub, priv_key, raw_secret);
        
        unsigned char derived_key[32];
        sha256(raw_secret, secret_len, derived_key);

        e2e_sessions[sender] = { {0}, true };
        memcpy(e2e_sessions[sender].shared_key, derived_key, 32);

        unsigned char fp[32];
        sha256(derived_key, 32, fp);
        std::printf("[E2E] Session established with %s. Fingerprint: ", sender.c_str());
        for(int i=0; i<8; i++) std::printf("%02x", fp[i]);
        std::printf("\n");

        char *pub_hex = BN_bn2hex(pub_key);
        send_e2e_packet(sock, sender, "__E2E_ACK__", std::string(pub_hex));
        OPENSSL_free(pub_hex);

        BN_free(priv_key);
        BN_free(pub_key);
        BN_free(peer_pub);

    } else if (raw_content.rfind("__E2E_ACK__", 0) == 0) {
        std::cout << "[E2E] Acknowledgment received from " << sender << ". E2E Active.\n";

    } else if (raw_content.rfind("__E2E_MSG__", 0) == 0) {
        if (e2e_sessions.find(sender) != e2e_sessions.end() && e2e_sessions[sender].established) {
            std::string ciphertext_b64 = raw_content.substr(11);
            std::string decrypted = aes_gcm_decrypt(ciphertext_b64, e2e_sessions[sender].shared_key);
            std::cout << "[" << sender << " (E2E)]: " << decrypted << "\n";
        }
    }
}
